#!/bin/bash -f
#==============================================================================
# RISC CPU - Cadence Xcelium RTL Simulation
# Usage: ./go_sim
#==============================================================================

cd /home/share_file/cadence
source add_path
source add_license
cd -

echo ""
echo "======================="
echo "  RISC CPU - Testing"
echo "======================="
echo ""

echo "=== Unit Tests ==="
for tb in tb_address_mux tb_alu tb_alu_extended tb_controller tb_divider tb_hazard_unit tb_memory tb_multiplier tb_program_counter tb_register; do
    echo "Running $tb..."
    xrun -q -xmlibdirname output/xcelium.d -access rw -licqueue -64BIT -l output/run.log rtl/risc_cpu.v tb/tb_risc_cpu.v -top $tb
done

echo ""
echo "=== System Tests ==="

echo "[1/3] PROG1 (JMP/LDA/SKZ/STO/XOR)..."
xrun -q -xmlibdirname output/xcelium.d -access rw -licqueue -64BIT -l output/run.log rtl/risc_cpu.v tb/tb_risc_cpu.v +define+PROG=1 -top tb_risc_cpu

echo "[2/3] PROG2 (AND/ADD)..."
xrun -q -xmlibdirname output/xcelium.d -access rw -licqueue -64BIT -l output/run.log rtl/risc_cpu.v tb/tb_risc_cpu.v +define+PROG=2 -top tb_risc_cpu

echo "[3/3] PROG3 (Fibonacci)..."
xrun -q -xmlibdirname output/xcelium.d -access rw -licqueue -64BIT -l output/run.log rtl/risc_cpu.v tb/tb_risc_cpu.v +define+PROG=3 -top tb_risc_cpu

echo ""
echo "======================================================"
echo "  All tests completed!"
echo "======================================================"
